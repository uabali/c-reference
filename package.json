{
  "name": "c-reference",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node tools/copy-ort.mjs && next dev --port 43123 --hostname 0.0.0.0",
    "prebuild": "node tools/copy-ort.mjs",
    "build": "next build",
    "start": "next start --port 43123 --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "convert": "python3 tools/convert.py",
    "graph": "python3 tools/build_graph.py",
    "curated": "python3 tools/write_curated.py && python3 tools/build_graph.py",
    "embeddings": "node tools/build-embeddings.mjs",
    "examples": "python3 tools/check_examples.py",
    "test": "python3 -m pytest -q tests && node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "minisearch": "^7.2.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
